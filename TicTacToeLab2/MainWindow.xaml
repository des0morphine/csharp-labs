<Window x:Class="TicTacToeLab2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TicTacToeLab2.ViewModels"
        xmlns:m="clr-namespace:TicTacToeLab2.Models"
        Title="Хрестики-нулики"
        Height="540" Width="400"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <StackPanel Margin="15">
        <DockPanel Margin="0,0,0,10">
            <TextBlock Text="Складність:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox SelectedValue="{Binding SelectedDifficulty}" SelectedValuePath="Tag" Width="120">
                <ComboBoxItem Content="Легкий" Tag="{x:Static m:Difficulty.Easy}"/>
                <ComboBoxItem Content="Середній" Tag="{x:Static m:Difficulty.Medium}"/>
                <ComboBoxItem Content="Складний" Tag="{x:Static m:Difficulty.Hard}" IsSelected="True"/>
            </ComboBox>
        </DockPanel>

        <TextBlock HorizontalAlignment="Center" Margin="0,0,0,10" FontSize="14">
            <Run Text="Гравець: "/><Run Text="{Binding PlayerScore}" FontWeight="Bold"/>
            <Run Text=" | Нічиї: "/><Run Text="{Binding DrawScore}" FontWeight="Bold"/>
            <Run Text=" | Комп'ютер: "/><Run Text="{Binding ComputerScore}" FontWeight="Bold"/>
        </TextBlock>

        <ItemsControl ItemsSource="{Binding Cells}" Width="300" Height="300" HorizontalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="3" Columns="3"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Margin="2"
                            Command="{Binding ClickCommand}"
                            IsEnabled="{Binding IsEnabled}"
                            Content="{Binding Text}"
                            FontSize="36"
                            FontWeight="Bold"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{Binding StatusMessage}" FontSize="16" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,15,0,10"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Нова гра" Width="110" Height="32" Margin="0,0,10,0"
                    Command="{Binding NewGameCommand}"/>
            <Button Content="Скинути рахунок" Width="110" Height="32"
                    Command="{Binding ResetScoreCommand}"/>
        </StackPanel>
    </StackPanel>
</Window>
